generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum Role {
  GUEST
  HOST
  ADMIN
}
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}
enum PropertyType {
  HOMESTAY
  HOTEL
}
enum PropertyStatus {
  ACTIVE
  INACTIVE
}
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}
enum PaymentStatus {
  SUCCESS
  FAILED
}
enum PaymentMethod {
  FAKE
}
model User {
  id           String @id @default(uuid()) @db.Char(36)
  fullName     String @db.VarChar(100)
  phoneNumber  String? @db.VarChar(20)
  email        String @unique @db.VarChar(191)
  passwordHash String @db.VarChar(100)
  role         Role
  status       AccountStatus
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookingBlockedUntil DateTime?
  expirationStrikeResetAt DateTime?
  properties   Property[]
  bookings     Booking[]
  feedback     Feedback[]
  @@index([role, status])
}
model Property {
  id             String @id @default(uuid()) @db.Char(36)
  hostId         String @db.Char(36)
  host           User @relation(fields: [hostId], references: [id])
  type           PropertyType
  name           String @db.VarChar(150)
  slug           String? @unique @db.VarChar(191)
  description    String @db.Text
  district       String @db.VarChar(80)
  address        String @db.VarChar(250)
  depositPercent Int
  paymentWindowHours Int @default(6)
  checkInTime    String @default("14:00") @db.Char(5)
  checkOutTime   String @default("12:00") @db.Char(5)
  status         PropertyStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         PropertyImage[]
  amenities      PropertyAmenity[]
  roomTypes      RoomType[]
  feedback       Feedback[]
  @@index([hostId])
  @@index([status, district])
}
model RoomType {
  id            String @id @default(uuid()) @db.Char(36)
  propertyId    String @db.Char(36)
  property      Property @relation(fields: [propertyId], references: [id])
  name          String @db.VarChar(100)
  description   String @db.Text
  pricePerNight Int
  totalUnits    Int
  maxGuests     Int
  bedrooms      Int
  beds          Int
  bathrooms     Int
  status        PropertyStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bookings      Booking[]
  @@index([propertyId, status, pricePerNight])
}
model PropertyImage {
  id         String @id @default(uuid()) @db.Char(36)
  propertyId String @db.Char(36)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String @db.VarChar(2048)
  sortOrder  Int
  @@unique([propertyId, sortOrder])
}
model Amenity {
  id         String @id @default(uuid()) @db.Char(36)
  code       String @unique @db.VarChar(50)
  nameVi     String @db.VarChar(100)
  active     Boolean @default(true)
  properties PropertyAmenity[]
}
model PropertyAmenity {
  propertyId String @db.Char(36)
  amenityId  String @db.Char(36)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity @relation(fields: [amenityId], references: [id])
  @@id([propertyId, amenityId])
  @@index([amenityId])
}
model Booking {
  id                     String @id @default(uuid()) @db.Char(36)
  bookingCode            String @unique @db.VarChar(40)
  customerNameSnapshot   String @default("") @db.VarChar(100)
  customerPhoneSnapshot  String @default("") @db.VarChar(20)
  customerEmailSnapshot  String @default("") @db.VarChar(191)
  propertyNameSnapshot   String @default("") @db.VarChar(150)
  propertyAddressSnapshot String @default("") @db.VarChar(250)
  guestId                String @db.Char(36)
  roomTypeId             String @db.Char(36)
  guest                  User @relation(fields: [guestId], references: [id])
  roomType               RoomType @relation(fields: [roomTypeId], references: [id])
  roomTypeNameSnapshot   String @db.VarChar(100)
  quantity               Int
  paymentDeadlineAt      DateTime
  expiredAt              DateTime?
  cancelledAt            DateTime?
  checkIn                DateTime @db.Date
  checkOut               DateTime @db.Date
  checkInTimeSnapshot    String @default("14:00") @db.Char(5)
  checkOutTimeSnapshot   String @default("12:00") @db.Char(5)
  guestCount             Int
  nightlyPriceSnapshot   Int
  totalNights            Int
  totalAmount            Int
  depositPercentSnapshot Int
  depositAmount          Int
  remainingAmount        Int
  status                 BookingStatus @default(PENDING_PAYMENT)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  payment                Payment?
  feedback               Feedback?
  @@index([guestId, createdAt])
  @@index([roomTypeId, status, checkIn, checkOut])
  @@index([status, paymentDeadlineAt])
  @@index([guestId, status, expiredAt])
}
model Feedback {
  id         String @id @default(uuid()) @db.Char(36)
  bookingId  String @unique @db.Char(36)
  guestId    String @db.Char(36)
  propertyId String @db.Char(36)
  booking    Booking @relation(fields: [bookingId], references: [id])
  guest      User @relation(fields: [guestId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])
  rating     Int
  content    String @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([propertyId, createdAt])
  @@index([guestId])
}
model Payment {
  id        String @id @default(uuid()) @db.Char(36)
  bookingId String @unique @db.Char(36)
  booking   Booking @relation(fields: [bookingId], references: [id])
  amount    Int
  status    PaymentStatus
  method    PaymentMethod @default(FAKE)
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

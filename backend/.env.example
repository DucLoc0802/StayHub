DATABASE_URL="mysql://ducklock:stayhub@mysql:3306/stayhub"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Production/Vercel: see .env.production.example.

# Booking policy (positive integers)
BOOKING_MINIMUM_LEAD_HOURS=2
BOOKING_EXPIRATION_THRESHOLD=3
BOOKING_EXPIRATION_PERIOD_DAYS=30
BOOKING_BLOCK_HOURS=24

# Local development only. Set before explicitly running the demo seed (8+ characters).
DEMO_PASSWORD=
# Secret for GET /api/internal/expire-bookings. Also configure it in your scheduler.
CRON_SECRET=

# Central MoMo collection; leave blank to disable checkout. No QR is used.
MOMO_RECEIVER_NAME=
MOMO_RECEIVER_PHONE=
# Verification is bounded by this window AND the original booking deadline (5–1440 minutes).
MOMO_VERIFICATION_WINDOW_MINUTES=60

# Vercel project: pentabug-stayhub (Root Directory: backend)
# Add these variables in Vercel > Settings > Environment Variables > Production.
NODE_ENV=production
FRONTEND_URL=https://pentabug2-stayhub.vercel.app

# Required: the connection string from your hosted MySQL provider.
# Vercel cannot reach the local Docker hostname "mysql" or localhost.
# Aiven REQUIRED TLS (Prisma parameters):
# mysql://avnadmin:URL_ENCODED_PASSWORD@mysql-stayhub-ducloc0802-ddd1.b.aivencloud.com:10718/defaultdb?sslaccept=accept_invalid_certs&connection_limit=1&connect_timeout=15&pool_timeout=20
DATABASE_URL=

# Required: a randomly generated secret of at least 32 characters.
JWT_SECRET=

BOOKING_MINIMUM_LEAD_HOURS=2
BOOKING_EXPIRATION_THRESHOLD=3
BOOKING_EXPIRATION_PERIOD_DAYS=30
BOOKING_BLOCK_HOURS=24
# Protected scheduled expiration endpoint; never expose this in frontend variables.
CRON_SECRET=

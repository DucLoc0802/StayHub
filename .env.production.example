# Public/operator-owned configuration; no values or credentials in this template.
PRODUCTION_DOMAIN=
FRONTEND_URL=
NEXT_PUBLIC_API_URL=
# Private server/database configuration.
DB_DATABASE=
DB_USER=
# Secrets: provision externally; never commit the populated file.
DB_ROOT_PASSWORD=
DB_PASSWORD=
DATABASE_URL=
JWT_SECRET=
CRON_SECRET=

# Central MoMo collection; leave blank to disable checkout. No QR is used.
MOMO_RECEIVER_NAME=
MOMO_RECEIVER_PHONE=
# Verification is bounded by this window AND the original booking deadline (5–1440 minutes).
MOMO_VERIFICATION_WINDOW_MINUTES=60

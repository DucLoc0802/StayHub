  "item": [
    {
      "name": "01 Tài khoản",
      "item": [
        {
          "name": "Đăng ký Khách thuê",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người dùng kiểm thử\",\n  \"email\": \"guest-{{runId}}@example.com\",\n  \"password\": \"StayHub123!\",\n  \"role\": \"GUEST\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"guestToken\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng ký Người cho thuê",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người dùng kiểm thử\",\n  \"email\": \"host-{{runId}}@example.com\",\n  \"password\": \"StayHub123!\",\n  \"role\": \"HOST\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"hostToken\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"hostId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
